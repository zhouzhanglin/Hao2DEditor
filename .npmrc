# Electron 二进制走国内镜像，避免 postinstall 下载中断导致 "Electron uninstall"
# 若使用代理或海外网络，可删除本文件
electron_mirror=https://npmmirror.com/mirrors/electron/
# 打包（npm run package:mac / package:win）时 electron-builder 要额外下 Electron 压缩包、
# NSIS / wine / winCodeSign 等工具，同样走国内镜像 —— electron-builder 会读 npm 导出的
# npm_config_electron_builder_binaries_mirror，所以写在这里就够，不必手动设环境变量
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
